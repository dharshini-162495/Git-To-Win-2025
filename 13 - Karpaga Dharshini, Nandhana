#include <stdio.h>
#include <string.h>

int main() {
    char word[] = "LEAP"; 
    int len = strlen(word); 

    for (int i = 0; i < len; i++) {
        for (int j = 0; j < len; j++) {
            if (i == j) {
                printf("%c ", word[i]); 
            } else {
                printf("* "); 
            }
        }
        printf("\n"); 
    }

    return 0;
}
